NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-to-a-different-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobtrackr


# .env.example: the template (public)

# Lists which variables the app needs, with placeholder or safe default values.
# It is committed to git, so everyone who clones the repo can see it.
# The app never reads it. It's documentation.